# Fleet configuration for the WAMP repositories: copy to ~/.config/fleet/wamp.env, chmod 600,
# and adjust. Read by fleet/lib/config.sh (every key and its default is listed there).
# The environment wins over this file: `EXCHANGE=other just fleet-where` is a one-off override.

# The inventory: which repositories, their slugs, default branches and waves.
FLEET_INVENTORY=$HOME/work/wamp/wamp-cicd/fleet.toml

# Where the clones live (one directory per repository, named as in the inventory).
FLEET_WORK_DIR=$HOME/work/wamp

# Name of the git remote that points at the exchange (the bare repositories shared by the
# AI host and the maintainer). Every clone must have it.
EXCHANGE=exchange

# Where collected CI results are uploaded for analysis (host:path). Empty: they stay local.
UPLOAD_TO=

# Rollout state and local CI copies default to ~/.fleet/wamp and ~/fleet-ci/wamp.
